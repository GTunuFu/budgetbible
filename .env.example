# Postgres connection string (Vercel → Storage → Neon creates this for you)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# The password you type to open the app
APP_PASSWORD=pick-a-long-passphrase

# Random 32+ char string. Signs your login cookie and encrypts your SimpleFIN access key.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Random string Vercel Cron sends so only it can trigger the daily sync
CRON_SECRET=
